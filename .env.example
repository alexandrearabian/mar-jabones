# Copiá este archivo como .env (o .env.local) y completá los valores.

# URL pública del sitio (sitemap, metadatos)
NEXT_PUBLIC_SITE_URL=https://marjabones.com

# sanity.io/manage → tu proyecto → "Project ID"
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Solo para `pnpm import:catalog`: token con permiso "Editor"
# (sanity.io/manage → API → Tokens). Borralo cuando termine la importación.
SANITY_API_WRITE_TOKEN=
